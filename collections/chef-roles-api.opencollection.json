{
  "opencollection": "1.0.0",
  "info": {
    "name": "Chef Automate Channels Roles API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api-token",
      "value": "{{api-token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Roles",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List roles",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{automate}/api/v0/roles"
          },
          "docs": "List roles"
        },
        {
          "info": {
            "name": "Create a role",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{automate}/api/v0/roles",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a role"
        },
        {
          "info": {
            "name": "Get a role",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{automate}/api/v0/roles/:roleName",
            "params": [
              {
                "name": "roleName",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get a role"
        }
      ]
    }
  ],
  "bundled": true
}