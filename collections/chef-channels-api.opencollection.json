{
  "opencollection": "1.0.0",
  "info": {
    "name": "Chef Automate Channels API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api-token",
      "value": "{{api-token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Channels",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List channels for an origin",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{automate}/api/v0/depot/channels/:origin",
            "params": [
              {
                "name": "origin",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "List channels for an origin"
        }
      ]
    }
  ],
  "bundled": true
}