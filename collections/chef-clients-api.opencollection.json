{
  "opencollection": "1.0.0",
  "info": {
    "name": "Chef Automate Channels Clients API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api-token",
      "value": "{{api-token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Clients",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List API clients",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{automate}/api/v0/clients"
          },
          "docs": "List API clients"
        }
      ]
    }
  ],
  "bundled": true
}